# Copier en .env.local.
# Mode explicite : demo (données fictives, sans connexion) ou live (Supabase obligatoire).
# En production, l'application refuse de démarrer si ce mode est absent ou incohérent.
NEXT_PUBLIC_APP_MODE=demo

# Obligatoires en mode live
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique de l'application : sert à construire les liens de connexion (obligatoire en production live).
# À déclarer aussi dans Supabase > Authentication > URL Configuration > Redirect URLs : <SITE_URL>/auth/callback
NEXT_PUBLIC_SITE_URL=

# Serveur uniquement, jamais préfixée NEXT_PUBLIC_ ; inutile pour l'application web au Sprint 1.
SUPABASE_SERVICE_ROLE_KEY=
