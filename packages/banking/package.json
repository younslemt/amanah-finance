{
  "name": "@amanah/banking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Abstraction des sources bancaires (démo, CSV, puis fournisseurs PSD2).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:node": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/vitest-banking.xml",
    "lint": "echo \"lint: couvert par le typecheck strict\""
  },
  "dependencies": {
    "@amanah/engines": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
